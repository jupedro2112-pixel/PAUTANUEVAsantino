+
+  // ── Por referidor ──
+  const byReferrer = new Map();
+  const firstReferralByReferrer = new Map();
+  const cut30 = now.getTime() - 30 * 24 * 3600 * 1000;
+  for (const r of referred) {
+    const rid = r.referredByUserId;
+    let s = byReferrer.get(rid);
